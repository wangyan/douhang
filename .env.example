# SQLite 数据库路径（相对于项目根目录）
# 开发环境默认 file:./data/sqlite.db；Docker 容器内为 file:./data/sqlite.db
DATABASE_URL="file:./data/sqlite.db"

# 服务时区（IANA 标识，如 Asia/Shanghai、Asia/Tokyo、UTC）
# 默认东八区，影响服务端日期计算与容器内系统时间
TZ="Asia/Shanghai"

# NextAuth 配置
# AUTH_SECRET 至少 32 字符，生产环境务必修改（可用：openssl rand -base64 32）
AUTH_SECRET="please-change-this-secret-in-production-32chars"

# 默认管理员账号（首次 npm run db:seed 时写入数据库）
AUTH_USERNAME="admin"
# 必填：管理员登录口令（此处有意留空以防默认口令上线，部署前请务必填写！）
# - 必须至少 8 位，禁止 changeme / 12345678 / admin123 等常见弱口令
# - 可使用命令生成随机强口令：openssl rand -base64 18
# - 仅在数据库首次初始化时写入 admin 账号；每次启动容器均会执行防呆校验（未设置则中止启动）
AUTH_PASSWORD=

# 反向代理/域名部署时的公开访问地址（可选；用于 NextAuth 回调与登出跳转）
# AUTH_URL="https://douhang.example.com"

# Docker 监控数据源（可选）
# - 留空：默认连接 unix socket /var/run/docker.sock
# - tcp://host:2375：远程 Docker host
# - unix:///var/run/docker.sock：显式指定 socket 路径
# DOCKER_HOST="unix:///var/run/docker.sock"

# ==============================================================================
# 以下为维护者版本发布与多端镜像分发配置（自托管日常部署无需配置）
# ==============================================================================

# 1. 官方 GitHub 发版凭据（用于 scripts/release.sh 创建 Release 与发布标签）
# 推荐 Fine-grained PAT（https://github.com/settings/personal-access-tokens/new）：
# - Repository access：仅勾选 douhang 仓库
# - Permissions：仅勾选 Contents: Read and write
# GITHUB_TOKEN="github_pat_xxxx"

# 2. 官方国内镜像仓发版凭据 (AtomGit，用于 scripts/release.sh 同步推送代码与创建 Release)
# ATOMGIT_TOKEN="atomgit_token_xxxx"

# 3. 官方 GitHub 镜像库推送凭据（可选；用于本地编译直推 ghcr.io）
# 说明：官方多架构镜像默认由 GitHub Actions 云端自动构建交付，本地无需配置；
# 仅当设置 BUILD_IMAGE_LOCAL=1 在本地交叉编译并直推 ghcr.io 时，配置具备 write:packages 的 Classic PAT：
# BUILD_IMAGE_LOCAL=0
# GHCR_TOKEN="ghp_xxxx"

# 4. 官方 Docker Hub 镜像发布（用于 npm run image:sync 流转官方镜像至 hub.docker.com）
# DOCKERHUB_USERNAME="your-dockerhub-username"
# DOCKERHUB_TOKEN="dckr_pat_xxxx"

# 5. 国内 HamGit 平台同步（可选；用于发版时将 Release 与镜像同步至国内平台）
# - HAMGIT_REPO_URL：国内 Git 仓库地址（如 ssh://git@hamgit.com/wangyan/douhang.git）
#   * 脚本会自动从该 URL 提取主机名（hamgit.com）与仓库路径（wangyan/douhang）
#   * 默认自动将镜像库设为该主机名、用户设为 wangyan，无需手动配置
# - HAMGIT_REPO_TOKEN：国内平台 API 访问令牌（用于同步创建 Release）
# - HAMGIT_REGISTRY_TOKEN：国内镜像库访问令牌（用于同步或直推容器镜像）
# HAMGIT_REPO_URL="ssh://git@hamgit.com/wangyan/douhang.git"
# HAMGIT_REPO_TOKEN="your-hamgit-repo-token"
# HAMGIT_REGISTRY_TOKEN="your-hamgit-registry-token"
