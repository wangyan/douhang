# SQLite 数据库路径（相对于项目根目录）
# 开发环境默认 file:./data/sqlite.db；Docker 容器内为 file:./data/sqlite.db
DATABASE_URL="file:./data/sqlite.db"

# NextAuth 配置
# AUTH_SECRET 至少 32 字符，生产环境务必修改（可用：openssl rand -base64 32）
AUTH_SECRET="please-change-this-secret-in-production-32chars"

# 默认管理员账号（首次 npm run db:seed 时写入数据库）
AUTH_USERNAME="admin"
# 必填：管理员登录口令（此处有意留空以防默认口令上线，部署前请务必填写！）
# - 必须至少 8 位，禁止 changeme / 12345678 / admin123 等常见弱口令
# - 可使用命令生成随机强口令：openssl rand -base64 18
# - 仅在数据库首次初始化时写入 admin 账号；每次启动容器均会执行防呆校验（未设置则中止启动）
AUTH_PASSWORD=

# 反向代理/域名部署时的公开访问地址（可选；用于 NextAuth 回调与登出跳转）
# AUTH_URL="https://douhang.example.com"

# Docker 监控数据源（可选）
# - 留空：默认连接 unix socket /var/run/docker.sock
# - tcp://host:2375：远程 Docker host
# - unix:///var/run/docker.sock：显式指定 socket 路径
# DOCKER_HOST="unix:///var/run/docker.sock"

# ==============================================================================
# 自定义主仓库与镜像源（可选；默认指向官方开源仓库，用于自建平台或 Fork 二次开发）
# ==============================================================================

# 主代码托管平台域名（默认：github.com；支持自建 Forgejo / Gitea / GitLab 等）
# MAIN_GIT_HOST="github.com"

# 主仓库路径（默认：wangyan/douhang；可替换为您的 Fork 用户名/组织名与仓库名）
# MAIN_REPO_NAME="wangyan/douhang"

# 主容器镜像库域名（默认：当 MAIN_GIT_HOST 为 GitHub 时为 ghcr.io，其他平台默认同 MAIN_GIT_HOST）
# MAIN_REGISTRY="ghcr.io"

# 主容器镜像库登录用户名（默认自动提取 MAIN_REPO_NAME 的命名空间）
# MAIN_REGISTRY_USER="wangyan"

# 版本检测令牌（可选；仅当将主仓库设为私有仓库且需要应用内自动检查新版本时配置）
# UPDATE_CHECK_TOKEN="your-read-only-token"

# ==============================================================================
# 以下为版本发布与镜像多端分发配置（维护者运行 scripts/release.sh 与 image-sync 时使用）
# ==============================================================================

# 主仓库发版凭据（用于创建 Release 与推送标签）
# 说明：多架构容器镜像默认由 GitHub Actions 云端自动构建并交付至 GHCR（无需本地构建，零机器负荷）
# 推荐使用 Fine-grained tokens（https://github.com/settings/personal-access-tokens/new）：
# - Repository access：仅选「Only select repositories」-> 仅勾选 douhang 仓库
# - Permissions：仅勾选 Contents: Read and write（无其他代码或管理权限）
# MAIN_REPO_TOKEN="github_pat_xxxx"

# 本地多架构镜像构建后备开关（可选；默认 0）
# - 默认 0：由 GitHub Actions 云端构建交付至 GHCR；后续使用 npm run image:sync 高速同步至私有平台与 Docker Hub
# - 设为 1：在发版脚本中直接在本地调用 Docker 进行跨架构构建与直推（需本地 Docker 运行且配置 MAIN_REGISTRY_TOKEN）
# BUILD_IMAGE_LOCAL=0
# MAIN_REGISTRY_TOKEN="ghp_xxxx"

# 镜像平台同步配置（可选；用于 scripts/release.sh 发版同步与 npm run image:sync 镜像分发）
# - MIRROR_REPO_URL：私有 Git 仓库地址（如 ssh://git@mirror.example.com/owner/douhang.git）
#   * 脚本会自动从该 URL 智能提取主机名（mirror.example.com）与仓库路径（owner/douhang）
#   * 默认自动将 MIRROR_REGISTRY 设为该主机名、MIRROR_REGISTRY_USER 设为 owner，无需手动配置
# - MIRROR_REPO_TOKEN：私有平台 API 令牌（用于同步创建 Release）
# - MIRROR_REGISTRY_TOKEN：私有镜像库访问令牌（用于同步或直推容器镜像）
# - 如需显式覆盖自动推导参数，可按需可选配置：MIRROR_GIT_HOST / MIRROR_REPO_NAME / MIRROR_REGISTRY / MIRROR_REGISTRY_USER
# MIRROR_REPO_URL="ssh://git@mirror.example.com/owner/douhang.git"
# MIRROR_REPO_TOKEN="your-mirror-repo-token"
# MIRROR_REGISTRY_TOKEN="your-mirror-registry-token"

# Docker Hub 平台同步（可选；用于 npm run image:sync 分发公开镜像至 hub.docker.com）
# - DOCKERHUB_USERNAME：Docker Hub 用户名（如 wangyan）
# - DOCKERHUB_TOKEN：Docker Hub Personal Access Token（需具备 Read & Write 权限）
# - DOCKERHUB_REPO：Docker Hub 仓库路径（默认取 ${DOCKERHUB_USERNAME}/douhang）
# DOCKERHUB_USERNAME="your-dockerhub-username"
# DOCKERHUB_TOKEN="dckr_pat_xxxx"
# DOCKERHUB_REPO="your-dockerhub-username/douhang"
