# SQLite 数据库路径（相对于项目根目录）
# 开发环境默认 file:./data/sqlite.db；Docker 容器内为 file:./data/sqlite.db
DATABASE_URL="file:./data/sqlite.db"

# NextAuth 配置
# AUTH_SECRET 至少 32 字符，生产环境务必修改（可用：openssl rand -base64 32）
AUTH_SECRET="please-change-this-secret-in-production-32chars"

# 默认管理员账号（首次 npm run db:seed 时写入数据库）
AUTH_USERNAME="admin"
# 必填（升级安装同样必填）：登录口令，至少 8 位，禁止 changeme / 请修改默认密码等弱口令。
# 仅在数据库为空时写入账号，但每次启动都会校验，缺失会让容器启动中止。
AUTH_PASSWORD=

# 反向代理/域名部署时的公开访问地址（可选；用于 NextAuth 回调与登出跳转）
# AUTH_URL="https://douhang.example.com"

# Docker 监控数据源（可选）
# - 留空：默认连接 unix socket /var/run/docker.sock
# - tcp://host:2375：远程 Docker host
# - unix:///var/run/docker.sock：显式指定 socket 路径
# DOCKER_HOST="unix:///var/run/docker.sock"

# 远端托管平台配置（默认连接 code.bg7pbp.com，切换至私有 GitHub 仅需修改此处）
# - CODE_HOST: 代码仓库域名（如 code.bg7pbp.com 或 github.com，默认：code.bg7pbp.com）
# - REPO_NAME: 仓库路径（如 wangyan/douhang，默认：wangyan/douhang）
# - CONTAINER_REGISTRY: 容器镜像库域名（可选；未配置时：github.com 自动匹配 ghcr.io，其他默认同 CODE_HOST）
# CODE_HOST="code.bg7pbp.com"
# REPO_NAME="wangyan/douhang"
# CONTAINER_REGISTRY="code.bg7pbp.com"

# 远端托管平台授权令牌（私有仓库/镜像库场景）
# - REPO_TOKEN：仓库权限（用于发版创建 Release、Git 推送，以及服务端私有版本检测兜底）
# - PACKAGE_TOKEN：容器镜像库权限（用于发版脚本执行 docker login 并推送镜像）
# - UPDATE_CHECK_TOKEN：版本检测专用令牌（可选；未配置时自动回落至 REPO_TOKEN）
# REPO_TOKEN="your-repo-token"
# PACKAGE_TOKEN="your-package-token"
# UPDATE_CHECK_TOKEN="your-update-check-token"

# 容器镜像库登录用户名（发版脚本 docker login 使用；默认取仓库 owner）
# DOCKER_USER="your-docker-user"
