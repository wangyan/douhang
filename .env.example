# SQLite 数据库路径（相对于项目根目录）
# 开发环境默认 file:./data/sqlite.db；Docker 容器内为 file:./data/sqlite.db
DATABASE_URL="file:./data/sqlite.db"

# NextAuth 配置
# AUTH_SECRET 至少 32 字符，生产环境务必修改（可用：openssl rand -base64 32）
AUTH_SECRET="please-change-this-secret-in-production-32chars"

# 默认管理员账号（首次 npm run db:seed 时写入数据库）
AUTH_USERNAME="admin"
# 必填：管理员登录口令（此处有意留空以防默认口令上线，部署前请务必填写！）
# - 必须至少 8 位，禁止 changeme / 12345678 / admin123 等常见弱口令
# - 可使用命令生成随机强口令：openssl rand -base64 18
# - 仅在数据库首次初始化时写入 admin 账号；每次启动容器均会执行防呆校验（未设置则中止启动）
AUTH_PASSWORD=

# 反向代理/域名部署时的公开访问地址（可选；用于 NextAuth 回调与登出跳转）
# AUTH_URL="https://douhang.example.com"

# Docker 监控数据源（可选）
# - 留空：默认连接 unix socket /var/run/docker.sock
# - tcp://host:2375：远程 Docker host
# - unix:///var/run/docker.sock：显式指定 socket 路径
# DOCKER_HOST="unix:///var/run/docker.sock"

# ==============================================================================
# 自定义主仓库与镜像源（可选；默认指向官方开源仓库，用于自建平台或 Fork 二次开发）
# ==============================================================================

# 主代码托管平台域名（默认：github.com；支持自建 Forgejo / Gitea / GitLab 等）
# CODE_HOST="github.com"

# 主仓库路径（默认：wangyan/douhang；可替换为您的 Fork 用户名/组织名与仓库名）
# REPO_NAME="wangyan/douhang"

# 容器镜像库域名（默认：当 CODE_HOST 为 GitHub 时为 ghcr.io，其他平台默认同 CODE_HOST）
# CONTAINER_REGISTRY="ghcr.io"

# 容器镜像库登录用户名（默认自动提取 REPO_NAME 的命名空间）
# DOCKER_USER="wangyan"

# 版本检测令牌（可选；仅当将主仓库设为私有仓库且需要应用内自动检查新版本时配置）
# UPDATE_CHECK_TOKEN="your-read-only-token"

# ==============================================================================
# 以下为版本发布配置（维护者运行 scripts/release.sh 时使用，常规部署无需配置）
# ==============================================================================

# 发版凭据（用于创建 Release 与推送标签）
# 说明：Docker 镜像默认由 GitHub Actions 云端自动完成多架构构建并推送（无需本地构建，零机器负荷）
# 推荐使用 Fine-grained tokens（https://github.com/settings/personal-access-tokens/new）：
# - Repository access：仅选「Only select repositories」-> 仅勾选 douhang 仓库
# - Permissions：仅勾选 Contents: Read and write（无其他代码或管理权限）
# REPO_TOKEN="github_pat_xxxx"

# 本地 Docker 镜像构建（可选；默认 0）
# - 默认 0：由 GitHub Actions 云端流水线自动完成多架构构建与多端分发（秒级发版，无需本地 Docker）
# - 设为 1：在本地调用 docker buildx 进行跨架构编译并推送（需本地 Docker 运行且必须配置 PACKAGE_TOKEN）
# BUILD_DOCKER_LOCAL=0
# PACKAGE_TOKEN="ghp_xxxx"

# 私有镜像平台同步（可选；发版时自动同步推送至私有 Git 仓库、私有镜像库并创建 Release）
# - MIRROR_REPO_URL：私有 Git 仓库地址（如 ssh://git@mirror.example.com/owner/douhang.git）
# - MIRROR_CODE_HOST：私有托管平台域名（如 mirror.example.com，用于创建 Release）
# - MIRROR_REPO_NAME：私有仓库路径（默认同主仓库）
# - MIRROR_CONTAINER_REGISTRY：私有镜像库域名（默认同 MIRROR_CODE_HOST）
# - MIRROR_DOCKER_USER：私有镜像库登录用户（默认取仓库 owner）
# - MIRROR_REPO_TOKEN：私有平台仓库令牌（用于创建 Release）
# - MIRROR_PACKAGE_TOKEN：私有镜像库推送令牌（用于推送 Docker 镜像）
# MIRROR_REPO_URL="ssh://git@mirror.example.com/owner/douhang.git"
# MIRROR_CODE_HOST="mirror.example.com"
# MIRROR_REPO_TOKEN="your-mirror-repo-token"
# MIRROR_PACKAGE_TOKEN="your-mirror-package-token"
