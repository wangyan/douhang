{
  "name": "douhang",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/generate-changelog.ts",
    "dev": "node scripts/clean-next.mjs && next dev",
    "build": "tsx scripts/generate-changelog.ts && next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "gen:changelog": "tsx scripts/generate-changelog.ts",
    "release:sync": "tsx scripts/sync-releases.ts",
    "release:check": "tsx scripts/sync-releases.ts --dry-run",
    "image:sync": "bash scripts/image-sync.sh",
    "image:check": "bash scripts/image-sync.sh --check",
    "doctor": "npx react-doctor@latest --verbose --scope changed",
    "doctor:full": "npx react-doctor@latest --verbose",
    "db:generate": "prisma generate",
    "predb:seed": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.8",
    "@astryxdesign/theme-neutral": "^0.6.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@stylexjs/stylex": "^0.19.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "parse5": "^8.0.1",
    "pinyin-pro": "^3.29.5",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.89.0",
    "swr": "^2.5.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild": true,
    "@astryxdesign/core": false,
    "fsevents": false
  }
